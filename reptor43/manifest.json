{
  "name": "God's Eye View · Portal Académico USM",
  "short_name": "God's Eye View",
  "description": "PWA académica offline para estudiantes USM: horario, bloques libres, avance de malla, materiales y asistente local.",
  "lang": "es-CL",
  "dir": "ltr",
  "id": "./",
  "start_url": "./#/",
